# dashboard（Cloudflare Workers）の公開URL（末尾の /api は不要）
DASHBOARD_API_URL=https://your-dashboard.example.com

# Cloudflare Access の service token（scrape-tv-program の WATCH_LIST_ACCESS_* と同じ値でよい）
DASHBOARD_ACCESS_CLIENT_ID=
DASHBOARD_ACCESS_CLIENT_SECRET=

# Obsidian のモーニングページのフォルダ（YYYY/MM/DD.md が並ぶところ）。設定すると、日報に6節目「予定と振り返り」を書き足す
MORNING_PAGE_DIR=
